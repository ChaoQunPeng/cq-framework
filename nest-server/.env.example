# 服务端基础配置
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/cq-framework?replicaSet=rs0
# 启动服务前设置独立的随机密钥；不要将真实密钥提交到仓库。
JWT_SECRET=
JWT_EXPIRES=7d
PORT=3000
UPLOAD_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:8000

# 种子脚本（npm run seed）写入的初始超级管理员；运行前必须填写独立密码。
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PHONE=13800000000
SEED_ADMIN_PASSWORD=
